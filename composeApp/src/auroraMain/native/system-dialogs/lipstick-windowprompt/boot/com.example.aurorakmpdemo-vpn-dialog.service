[Unit]
Description=Aurora KMP demo system VPN restart dialog (development only)
After=dbus.service systemd-user-sessions.service
RequiresMountsFor=/home/defaultuser

[Service]
Type=simple
ExecStart=/bin/sh /usr/local/libexec/aurora-kmp-vpn-dialog boot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
